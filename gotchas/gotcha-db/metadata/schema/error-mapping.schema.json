{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gotcha-db/schema/error-mapping.schema.json",
  "title": "Error mapping record",
  "type": "object",
  "required": ["schema_version", "id", "match", "gotchas"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9_/-]+$" },
    "match": { "type": "string", "description": "Regex matched against observed error output." },
    "language": { "type": "string" },
    "platform": { "type": "string" },
    "gotchas": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Gotcha ids this error maps to, most likely first."
    }
  }
}
